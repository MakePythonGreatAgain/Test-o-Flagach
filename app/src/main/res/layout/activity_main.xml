<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:background="#96dcab"
    tools:context=".MainActivity">
    <!-- na środek ekranu tam gdzie gravity -->
    <!--
    Każdy elementu musi mieć zdefiniowana wysokość i szerokość może być w dp (pixele niezależne)
    match_parent - dopasuj do rozmiaru elementu nadrzędnego (Bierzemy całą wysokość lub szerokość od rodzica)
    wrap_content - dopasuj do zawartości
     -->

    <TextView
        android:id = "@+id/textViewPolecenie"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Wybierz kolory których nie ma w fladze poski"
        android:textSize="20sp"
        android:layout_margin="16dp"
        android:padding="8dp"
        android:background="@color/Rule34"
        android:textColor="@color/TloNapisu"
        android:textAlignment="center"
        />
        <!-- Margin , textSize, padding,
        background tint i tint (z wyjątkiem przycisków), textColor, text Aligment -->


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <!-- w height wrap aby wszystkich buttonów nie zasłaniał -->

        <Button
            android:id="@+id/button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:backgroundTint="@color/Lorax"
            android:layout_margin="10dp"
            android:onClick="WybierzKolor"
            />

        <Button
            android:id="@+id/button2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:backgroundTint="@color/white"
            android:layout_margin="10dp"
            android:onClick="WybierzKolorOk"
            />

        <Button
            android:id="@+id/button3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:backgroundTint="@color/GreenBuge"
            android:layout_margin="10dp"
            android:onClick="WybierzKolor"
            />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <!-- w height wrap aby wszystkich buttonów nie zasłaniał -->

        <Button
            android:id="@+id/button4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:backgroundTint="@color/Pink"
            android:layout_margin="10dp"
            android:onClick="WybierzKolor"
            />

        <Button
            android:id="@+id/button5"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:backgroundTint="@color/Blood"
            android:layout_margin="10dp"
            android:onClick="WybierzKolorOk"
            />

        <Button
            android:id="@+id/button6"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:backgroundTint="@color/AryjskieOczy"
            android:layout_margin="10dp"
            android:onClick="WybierzKolor"
            />

    </LinearLayout>

</LinearLayout>